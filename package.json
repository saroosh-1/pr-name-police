{
  "name": "PrNamePolice",
  "displayName": "PrNamePolice",
  "description": "Fix PR names in GitHub PRs according to conventions",
  "version": "0.0.7",
  "publisher": "prnamepolice",
  "icon": "images/pr_name_fixer.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/saroosh-1/pr-name-police"
  },
  "bugs": {
    "url": "https://github.com/saroosh-1/pr-name-police/issues"
  },
  "homepage": "https://github.com/saroosh-1/pr-name-police#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Fix PR name",
      "properties": {
        "PrNamePolice.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging in console"
        }
      }
    },
    "commands": [
      {
        "command": "pr-name-fixer.executeTask",
        "title": "Fix PR name"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "mocha": "^11.5.0",
    "typescript": "^5.4.5"
  }
}